{"segs": ["ZH_T19_0974A_001:0384b14_100_42", "ZH_T19_0974A_001:0384b14_100_43", "ZH_T19_0974A_001:0384b14_100_44"], "en": "VAJRĀGRETAVI 56. JAYĀGRETAVI 57. VIJAYĀGRETAVI 58. VAJRĀVĪRAGRETAVI 59. VA... [The text ends here.]", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
