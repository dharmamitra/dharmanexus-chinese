[
{"segs": ["ZH_T19_0974A_001:0383c04_0"], "en": "The Sūtra of the Dhāraṇī of the Most Victorious Buddha-Uṣṇīṣa,", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0383c06_0", "ZH_T19_0974A_001:0383c07_0"], "en": "translated by the Tripiṭaka Śramaṇa Fǎtián, recipient of the purple robe, from Nālandā Monastery in Magadha, Central India, in the Western Heavens.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_0", "ZH_T19_0974A_001:0384b14_100_1", "ZH_T19_0974A_001:0384b14_100_2"], "en": "Namo bhagavate saṃkusumitarājendrāya tathāgatāyārhate samyaksaṃbuddhāya.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_3", "ZH_T19_0974A_001:0384b14_100_4", "ZH_T19_0974A_001:0384b14_100_5"], "en": "1. *Tadyathā* 2. *Oṃ muṃ muṃ muṃ* 3. *śodhaya śodhaya* 4. *viśodhaya viśodhaya* 5. *asama*", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_6", "ZH_T19_0974A_001:0384b14_100_7"], "en": "*Samanta-vāvasa-saṃharaṇa-gati-gagana-svabhāva-viśuddhe niḥśeṣam.* (11) *Svāhā.* (12) *Bhiḥ.* (13) [Note:", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_8"], "en": "The provided text contains transliterated Sanskrit mantras with specific phonetic instructions for pronunciation.]", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_9"], "en": "Jin fan zuo du xian mou gan fan (13 syllables);", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_10"], "en": "sa zhuan she wa wu ke fan da ta qu ye da (14 syllables); su shang ye da (15 syllables);", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_11"], "en": "ba la ba yin zuo na yin (16 syllables); mi li er he da bi sai se ye fan jie ju you.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_12", "ZH_T19_0974A_001:0384b14_100_13"], "en": "17. *Vajramukha hūṃ nīlāmbaradhara* 18. *pāṇau oṃ āhara āhara* 19.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_14"], "en": "*ayur-dhāraṇi* (or *āyurdhāraṇi*) 20. *jīvani* (or *jīvantī*)", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_15", "ZH_T19_0974A_001:0384b14_100_16", "ZH_T19_0974A_001:0384b14_100_17"], "en": "ŚUṂ DHA YA ŚUṂ DHA YA (21) GAGANA SVĀHĀ VAJRA (22) UṢṆĪṢA VIJAYA PARAJITA (23) SAHASRĀRAKA.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_18", "ZH_T19_0974A_001:0384b14_100_19", "ZH_T19_0974A_001:0384b14_100_20"], "en": "Śmaśāna-vidhvaṃsana-nirdeśa (24) | Sarvajñātāgata (25) | Vajragīte (26) | Sarvajñātāgata (27) ||", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_21", "ZH_T19_0974A_001:0384b14_100_22", "ZH_T19_0974A_001:0384b14_100_23"], "en": "Māte (27) kuṣṭhapara-mita (28) paripūrṇi (29) naśabhumiprati-ṣṭhite (30) sarva-tathāgata... (31) [The text ends here.]", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_24"], "en": "He gaccha hṛdaya (31), tiṣṭhata (32),", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_25", "ZH_T19_0974A_001:0384b14_100_26"], "en": "tiṣṭhati (33), oṃ mudra mudra (34), mahāmudra (35).", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_27", "ZH_T19_0974A_001:0384b14_100_28"], "en": "35. *vajrakāya* (vajra + kāya) 36. *saṃhatānupradīpti* (saṃhata + anu + pradīpti) 37.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_29"], "en": "*sarvavajramāvāranavidīpti* (sarva + vajra + m-āvāraṇa + vidīpti) 38. *prati-* (prati)", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T19_0974A_001:0384b14_100_30", "ZH_T19_0974A_001:0384b14_100_31"], "en": "39. *ḍiṃ khīṃ vartani cāmuṇḍe* | 40. *oṃ mukhe mukhe mahāmukhe* | 41.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
