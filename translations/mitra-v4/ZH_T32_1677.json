{"segs": ["ZH_T32_1677_001:0757b12_100_12", "ZH_T32_1677_001:0757b12_100_13", "ZH_T32_1677_001:0757b12_100_14"], "en": "Ghoṣa-triśrī-matī-ratnadhvaja-saddharmagupta-mantrī-sambuddhāgrya-dharmāgre dharmamahādharmarājye.", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_15", "ZH_T32_1677_001:0757b12_100_16", "ZH_T32_1677_001:0757b12_100_17"], "en": "16. *Saṃpratiṣṭha sattvānāṃ pracodaya hūṃ tathāgatajñānaḥ* 17. *Bodhi uddeśamānaḥ* 18. *Samyaktva-dharma-kṛte*.", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_18", "ZH_T32_1677_001:0757b12_100_19", "ZH_T32_1677_001:0757b12_100_20"], "en": "Ṭakki-nabhasa-puṇya-ra-darśate praśāntam | Naga-gara-pramudita-tīrthava-vāha-hūṃ viśvarūpiṇi || 21 ||", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_21", "ZH_T32_1677_001:0757b12_100_22", "ZH_T32_1677_001:0757b12_100_23"], "en": "Phaḥ phaṭ (22) Pūrṇe nīrvaṇāgaya (23) Daśanigānudgaṃ daṃ mahāritāṃ munina (24) sattvārthaka kṛpa.", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_24", "ZH_T32_1677_001:0757b12_100_25", "ZH_T32_1677_001:0757b12_100_26"], "en": "Namaḥ pañcaviṃśatimahā-jñānakāyaprajñājñānasugata-pratibimbanirvāṇa.", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_27", "ZH_T32_1677_001:0757b12_100_28", "ZH_T32_1677_001:0757b12_100_29"], "en": "tāṃ tārāyaṇaṃ kṛtāvadānapraṇamangurāmupacintāmantramoditavijayeti // 28–30 //", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
