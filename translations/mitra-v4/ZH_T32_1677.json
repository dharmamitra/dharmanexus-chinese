{"segs": ["ZH_T32_1677_001:0757b12_100_0", "ZH_T32_1677_001:0757b12_100_1", "ZH_T32_1677_001:0757b12_100_2"], "en": "Oṃ nikuṇḍanibhaga svaparahitāmahasambhanadharabuddho navavanavūnavava kāmiva samarasunṛvipa svāhā.", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_3", "ZH_T32_1677_001:0757b12_100_4", "ZH_T32_1677_001:0757b12_100_5"], "en": "vaśyavaśīkaraṇaṃ sarvasattvānāṃ me bhavatu prabhañja māṇibhadrātmane // 2 //", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
{"segs": ["ZH_T32_1677_001:0757b12_100_6", "ZH_T32_1677_001:0757b12_100_7", "ZH_T32_1677_001:0757b12_100_8"], "en": "Sampuṭa-mahoṣṇīṣa-dharmakāyājñānāṃ pūjya-tejomahendra-muditā-sukṛta-samabhaṅga-mudrā-nuyukti-piṇḍam.", "model": "mitra-v4", "translated_at": "2026-11-27T15:51:46Z"},
