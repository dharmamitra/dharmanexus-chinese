{"segs": ["ZH_T20_1055_001:0071c07_100_13", "ZH_T20_1055_001:0071c07_100_14", "ZH_T20_1055_001:0071c07_100_15"], "en": "*Ūṃ svāra-namuna-gati-miga-ru-danva-ho-lakṣaṇa-bhūṣita-svākāraṃ | Brahma-stava Brahma-stava pañcama-taru-kumāra-sādharapāṇi-da-laṃ-mili-gaḥ* || 5 ||", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1055_001:0071c07_100_16", "ZH_T20_1055_001:0071c07_100_17"], "en": "Vāśaka raṃ śubha guṇa ramaṇīya durlabha vimale māruta rana bindu laṃ | Brahma-stava Brahma-stava,", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
