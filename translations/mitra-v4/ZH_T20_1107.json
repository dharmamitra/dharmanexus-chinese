[
{"segs": ["ZH_T20_1107_001:0476b03_0"], "en": "The Sanskrit-Hymn to the Noble Bodhisattva Tārā,", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0476b05_0"], "en": "translated by the Tripitaka Master of the Western Heaven, Imperial Censor, Acting Minister of the Court of State Ceremonial,", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0476b06_0"], "en": "and Great Master of the Transmission of the Dharma, the Subject Shi Hu, by imperial decree.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_0", "ZH_T20_1107_001:0478b07_100_1", "ZH_T20_1107_001:0478b07_100_2"], "en": "Namo jñānadhareśvarīye bhagavati varadāyini devanāthayoginīndrabhadrīpramukuleye.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_3", "ZH_T20_1107_001:0478b07_100_4", "ZH_T20_1107_001:0478b07_100_5"], "en": "Nātharūpa-jñānamani-mayūkha-antakṛt-kṣatraprabhājvalita-cāpa-nirmukta-śara-stobha-ānanda-tariga.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_6", "ZH_T20_1107_001:0478b07_100_7", "ZH_T20_1107_001:0478b07_100_8"], "en": "Irṣyāntaritāśiraskandatarale māhupatnī-vāgatanayate vāmabāṇi-saṃthapūranasiddhiṃ devaramo.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_9", "ZH_T20_1107_001:0478b07_100_10", "ZH_T20_1107_001:0478b07_100_11"], "en": "Narumate-ṛṣi-kṣaṇi-ruru-kānta-kānte-kṛpā-viṣṭa-jite-pavara-pramṛṣṭe-śaraṇa.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_12", "ZH_T20_1107_001:0478b07_100_13", "ZH_T20_1107_001:0478b07_100_14"], "en": "Yavaraṇivakṭayanamami-praseṇānujaṃbha svāhā | Sitakharākharagaranibhigatavadhipanamate ||", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_15", "ZH_T20_1107_001:0478b07_100_16", "ZH_T20_1107_001:0478b07_100_17"], "en": "Āṃ poṃ poṃ svasti-ma-sti-ska-phaṅ-kaca-cara-jña-kta-rakta-ktaca-ṭha-pa-ṭhara-tānta-paśvaca-ṭha-laṃ viśa.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_18", "ZH_T20_1107_001:0478b07_100_19", "ZH_T20_1107_001:0478b07_100_20"], "en": "Lakṣa-mārasattva-ra-kta-nara-sa-raṅga-ṃ sakha-ra-khara-gara-mudraṇa-mantra-siddha-rāja-ma-vaṃ ga-bu.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_21", "ZH_T20_1107_001:0478b07_100_22", "ZH_T20_1107_001:0478b07_100_23"], "en": "At dawn, recite: *jvala nabhimaṇḍalaṃ ārañjira jvalantaṃ pradyotantaṃ tṛnavāya bha*.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_24", "ZH_T20_1107_001:0478b07_100_25", "ZH_T20_1107_001:0478b07_100_26"], "en": "Suraṅgula-ṛṣṭa-karālānāṃ viṣphuranta nirdantapraśamana-mṛgendra-krūda-raudra-garjana vāni.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_27", "ZH_T20_1107_001:0478b07_100_28", "ZH_T20_1107_001:0478b07_100_29"], "en": "Gaccha kāntārasattvānāṃ kṣemānugata-samitī-pratiṣṭha-saṃdhi-vināśana niścalaṃ prabodhaya kṣipraṃ parā...", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_30", "ZH_T20_1107_001:0478b07_100_31", "ZH_T20_1107_001:0478b07_100_32"], "en": "saṃnāgari-takārata-napana-trade-vatā-beli-muktā-rāja-karāna-nahita-krūdhāḥ.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_33", "ZH_T20_1107_001:0478b07_100_34", "ZH_T20_1107_001:0478b07_100_35"], "en": "Vaiśravaṇa-mahārāja-niṣṭhā-tathāgata-dharmamitra-paripālaka-jagad-dhātu-saṃrakṣaka-mayūradhvaja.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_36", "ZH_T20_1107_001:0478b07_100_37", "ZH_T20_1107_001:0478b07_100_38"], "en": "The body is like a *kūrparaka-lagna-tarasa-nakha-pratipanna-vṛttaka-lagnata-la-sat-māla-vi*.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_39", "ZH_T20_1107_001:0478b07_100_40", "ZH_T20_1107_001:0478b07_100_41"], "en": "Nirvṛte nirvṛtāṅga svastara-bhūta-vigraha kuśalaviśanāgāra-saṃjvalani-tan-nikā-dine hini vana-rava.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_42", "ZH_T20_1107_001:0478b07_100_43", "ZH_T20_1107_001:0478b07_100_44"], "en": "Dviraṇīnarūṇi samarāṇayūnye durbuddhataranirvāyudabhadantidatramudrāsada-ga.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_45", "ZH_T20_1107_001:0478b07_100_46", "ZH_T20_1107_001:0478b07_100_47"], "en": "Tāraṇī viśvatantranayana-sumati-śrīṅkhala-lalita-nitva-niścaya-lokamaheśvarī.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_48", "ZH_T20_1107_001:0478b07_100_49", "ZH_T20_1107_001:0478b07_100_50"], "en": "ānīya prabhavala-jalita-vātavega-hata-durmati-māravara-rudra-nirgapa-gubhyandhakāraṃ dānta-yūthi-kulani-tajvāla.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_51", "ZH_T20_1107_001:0478b07_100_52", "ZH_T20_1107_001:0478b07_100_53"], "en": "Ākṛṣya māṃ sarvapralaya-sphoṭa-nirghoṣa-vijñapti-svavikāra-vitara-sattva-likhita.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_54", "ZH_T20_1107_001:0478b07_100_55", "ZH_T20_1107_001:0478b07_100_56"], "en": "Lana hā hā ravapūritaṃ khaṭuṃkhaṃ vināśayantu karakalpana rīcī jvalan pradiptam jaḥ.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_57", "ZH_T20_1107_001:0478b07_100_58", "ZH_T20_1107_001:0478b07_100_59"], "en": "āyīṃ vidāriṃ tadya-laṅgana-mamatraṃ nṛ-ṇagrahaṇa-dantā-prasanna-mumuri-ścid-sukhite.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_60", "ZH_T20_1107_001:0478b07_100_61", "ZH_T20_1107_001:0478b07_100_62"], "en": "Kāru-vikṣaṇa-dāsa-tapate-nam-araṃ koṭi-lava-naṃ vibhrama-balaṃta-vipasa-puñca-samaviskṛta-krodha-mukha.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_63", "ZH_T20_1107_001:0478b07_100_64", "ZH_T20_1107_001:0478b07_100_65"], "en": "Tātparya-vatānuvidhāna-yogin-sapralambha-saṃśliṣṭa-viceṣṭana-gambhīra-mahā-gāmbhīrya.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_66", "ZH_T20_1107_001:0478b07_100_67", "ZH_T20_1107_001:0478b07_100_68"], "en": "Dvaya-ṛṃ ā-bhoja-gaṅga-dīpa-visphuraṇi-sukhā-haṃ jaḥ zla-ra-nabha-gava-ga-gara-saṃgana-ratna-tavi-śma-ja.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_69", "ZH_T20_1107_001:0478b07_100_70", "ZH_T20_1107_001:0478b07_100_71"], "en": "Lakāra-mudra-dvīpa-jana-ṭphaṇa-cakra-valaṃ mahā-vibhrama-kubjini-patanta-niṣṭraṅga-kridanta-gara.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_72", "ZH_T20_1107_001:0478b07_100_73", "ZH_T20_1107_001:0478b07_100_74"], "en": "Hakārala-stakarugra-nanda-nuru bhami-bhami praccha-kaṇṭha-drayuṃ ṭeṣṭha maśivi-sandri-vi-śubdama.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
{"segs": ["ZH_T20_1107_001:0478b07_100_75", "ZH_T20_1107_001:0478b07_100_76", "ZH_T20_1107_001:0478b07_100_77"], "en": "Ānīta-tāmrasnābha-saṃjñāti-vatā-manu-samitāye vi-kṣa-śa-na-sta-ni-bhūma-nava-nā-ku-hara-nirga.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
