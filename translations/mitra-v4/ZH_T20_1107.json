{"segs": ["ZH_T20_1107_001:0478b07_100_81", "ZH_T20_1107_001:0478b07_100_82", "ZH_T20_1107_001:0478b07_100_83"], "en": "dvitriṃdantāravāre jvalamāvartita-mayūraka-vālinī-nirvṛttatāyinī-prabhāṅgāra-lola-vāhini.", "model": "mitra-v4", "translated_at": "2026-11-27T15:40:14Z"},
